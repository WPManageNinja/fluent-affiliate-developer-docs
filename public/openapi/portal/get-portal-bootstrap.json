{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentAffiliate API",
    "description": "REST API documentation for FluentAffiliate — a WordPress affiliate program management plugin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-affiliate/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/portal/bootstrap": {
      "get": {
        "operationId": "getPortalBootstrap",
        "summary": "GET Get Portal Bootstrap",
        "description": "Get the data the affiliate portal app boots with: site info and the affiliate's share link parameters, additional sites, translated strings, the user, branded coupons, currency, menu items, QR code settings and date format. Only for an `active` affiliate. Filtered by `fluent_affiliate/portal_localize_data`.\n\nController: `PortalController@getBootstrap`\nRoute source: `app/Http/Routes/api.php`",
        "tags": [
          "Portal"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "site_info": {
                      "type": "object",
                      "properties": {
                        "site_url": {
                          "type": "string"
                        },
                        "site_name": {
                          "type": "string"
                        },
                        "share_url": {
                          "type": "string"
                        },
                        "aff_var": {
                          "type": "string",
                          "description": "Referral query variable, e.g. `ref`."
                        },
                        "aff_value": {
                          "type": "string",
                          "description": "This affiliate's referral parameter value."
                        }
                      }
                    },
                    "additional_sites": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "i18n": {
                      "type": "object"
                    },
                    "start_of_week": {
                      "type": "integer"
                    },
                    "user": {
                      "type": "object"
                    },
                    "branded_coupons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "currency": {
                      "type": "object"
                    },
                    "menu_items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "qr_code_settings": {
                      "type": "object"
                    },
                    "date_format": {
                      "type": "string",
                      "description": "WordPress date format converted to Day.js tokens."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Bad request."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Sorry, you are not allowed to do this."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
}
